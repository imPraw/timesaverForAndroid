<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OnePause" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/warm_paper</item>
        <item name="android:colorAccent">#E86F51</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OnePause.Pause" parent="Theme.OnePause">
        <item name="android:windowBackground">@color/forest_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
